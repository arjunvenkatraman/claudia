# Example machine-specific config. Copy the shape, not the values —
# run `./setup.sh` to generate a real containerconf/.env for this machine.
# This file is documentation only; it is never sourced.

XPAL_RUNTIME=podman
XPAL_IMAGE=xpal-claudia
XPAL_CONTAINER=xpal-dev
XPAL_CONTAINER_REMOTE=xpal-dev-remote
XPAL_HOST_SRC=/home/you/xpal-src
XPAL_HOST_DATA=/home/you/xpal-data
XPAL_HOST_AUTH=/home/you/xpal-auth
XPAL_HOST_UID=1000
XPAL_PORTS="5001:5001 8001:8001 8080:8080"
XPAL_HOST_REMOTE_DIR=
